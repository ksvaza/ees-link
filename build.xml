<?xml version="1.0" encoding="UTF-8"?>
<project name="EES-Link" default="build" basedir=".">
	<target name="clean">
		<delete includeemptydirs="true" quiet="true">
			<fileset dir="${basedir}/" includes="bin/**/*" defaultexcludes="false" />
		</delete>
	</target>

	<target name="test">
		<exec executable="go" failonerror="true">
			<arg line="test" />
			<arg line="./..." />
		</exec>
	</target>
	
	<target name="docker">
		<mkdir dir="bin" />
		<exec executable="docker" failonerror="true">
			<arg line="build" />
			<arg line="-f Dockerfile" />
			<arg line="-t ees-link-tmp" />
			<arg line="--target test" />
			<arg line="." />
		</exec>
		<exec executable="docker" failonerror="true">
			<arg line="run" />
			<arg line="-v ${basedir}${file.separator}bin:/opt/bin" />
			<arg line="--rm" />
			<arg line="-i" />
			<arg line="ees-link-tmp" />
			<arg line="cp -Rv /go/src/bin/tests/. /opt/bin/" />
		</exec>
		<exec executable="docker" failonerror="true">
			<arg line="run" />
			<arg line="-v ${basedir}${file.separator}.cache:/opt/bin" />
			<arg line="--rm" />
			<arg line="-i" />
			<arg line="ees-link-tmp" />
			<arg line="cp -R /go/pkg/mod/. /opt/bin/" />
		</exec>
		<exec executable="docker" failonerror="true">
			<arg line="build" />
			<arg line="-f Dockerfile" />
			<arg line="-t ees-link" />
			<arg line="." />
		</exec>
		<exec executable="docker" failonerror="true">
			<arg line="save" />
			<arg line="-o bin/ees-link.tar" />
			<arg line="ees-link" />
		</exec>
	</target>
	
	<target name="build" depends="clean,docker" />
</project>
